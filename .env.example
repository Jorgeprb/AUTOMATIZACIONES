# Public site and portal domains
APP_PUBLIC_DOMAIN=autogal.es
APP_PUBLIC_WWW_DOMAIN=www.autogal.es
APP_CLIENT_DOMAIN=client.autogal.es
# Copia a .env para levantar API, PostgreSQL y panel desde la raíz.
APP_ENVIRONMENT=development
LOG_LEVEL=INFO
INTERNAL_API_KEY=development-only-internal-key
ADMIN_API_KEY=development-only-admin-api-key
ENABLE_CALL_TRANSCRIPTION=false
PUBLIC_RATE_LIMIT_PER_MINUTE=60
WEBHOOK_RATE_LIMIT_PER_MINUTE=120
MAX_WEBHOOK_BODY_BYTES=1000000
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=https://replace-me.ngrok-free.app
FRONTEND_BASE_URL=http://localhost:5173

OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_WEBHOOK_SECRET=replace-with-openai-webhook-secret
OPENAI_PROJECT_ID=proj_replace_me
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_MODELS=gpt-realtime-2
OPENAI_REALTIME_VOICES=marin,cedar,alloy,ash,ballad,coral,echo,sage,shimmer,verse
TEST_CONSOLE_ENGINE=simulator
TEST_CONSOLE_MODEL=gpt-5.4-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Optional voice providers for preview/VPS Media Bridge.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GOOGLE_TTS_API_KEY=
ELEVENLABS_API_KEY=
AMAZON_POLLY_REGION=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
RESEMBLE_API_KEY=
RESEMBLE_TTS_URL=
CUSTOM_HTTP_TTS_URL=
CUSTOM_HTTP_TTS_API_KEY=
LOCAL_TTS_BASE_URL=

# SIP gateway for VPS Media Bridge.
SIP_BIND_HOST=0.0.0.0
SIP_PORT=6060
SIP_PUBLIC_DOMAIN=sip.autogal.es
SIP_PUBLIC_IP=51.210.180.115
RTP_PORT_MIN=10000
RTP_PORT_MAX=20000
RTP_ADVERTISE_IP=51.210.180.115
SIP_ALLOWED_IPS=
BACKEND_INTERNAL_URL=http://app:8000
OPENAI_HOSTED_SIP_STRATEGY=blocked
HEALTH_BIND_HOST=0.0.0.0
HEALTH_PORT=8088
MAX_CONCURRENT_CALLS=10
MAX_CALL_SECONDS=1800
INVITE_RATE_LIMIT_PER_MINUTE=60
FALLBACK_CALLED_NUMBER=

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://replace-me.ngrok-free.app/auth/google/callback
GOOGLE_LOGIN_ENABLED=false
GOOGLE_LOGIN_ADMIN_REDIRECT_URI=http://localhost:5173/auth/login/google/callback
GOOGLE_LOGIN_CLIENT_REDIRECT_URI=http://localhost:5174/auth/login/google/callback
GOOGLE_LOGIN_ALLOWED_DOMAIN=
GOOGLE_LOGIN_AUTO_PROVISION=false
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

CLINIC_TIMEZONE=Europe/Madrid
CLINIC_NAME=Clínica Demo
CLINIC_PHONE_NUMBER=+34910000000

POSTGRES_DB=clinic
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic_dev_password
# Producción gratuita:
# - Render Free Web Service usa DATABASE_URL de Supabase Free.
# - Puede venir como postgresql://...; la app lo normaliza a
#   postgresql+psycopg://...
# - Si el host es Supabase y falta sslmode, la app añade sslmode=require.
# Ejemplo:
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# o pooler:
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

VITE_API_BASE_URL=http://localhost:8000
VITE_ENABLE_DEV_FALLBACKS=false

# Cloudflare Pages production:
# VITE_API_BASE_URL=https://BACKEND_RENDER_URL
# VITE_ENABLE_DEV_FALLBACKS=false
#
# VPS production with Caddy:
# VITE_API_BASE_URL=https://APP_ADMIN_DOMAIN
# VITE_ENABLE_DEV_FALLBACKS=false

# Secure administrator sessions
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=Tatodobajocontrol
ADMIN_BOOTSTRAP_FORCE_PASSWORD_CHANGE=false
ADMIN_SESSION_TTL_HOURS=12
ADMIN_SECURE_COOKIES=false
VITE_API_TIMEOUT_MS=20000

# Retained unchanged for compatibility; the secure session-based frontend does not read this value.
VITE_ADMIN_API_KEY=development-only-admin-api-key

# Direct peers whose X-Forwarded-* headers are trusted.
TRUSTED_PROXY_IPS=127.0.0.1,::1
