# URL pública de FastAPI vista desde el navegador.
VITE_API_BASE_URL=http://localhost:8000
# Debe coincidir con ADMIN_API_KEY del backend en este MVP.
VITE_ADMIN_API_KEY=replace-with-local-admin-api-key
VITE_ENABLE_DEV_FALLBACKS=false

# Cloudflare Pages production:
# VITE_API_BASE_URL=https://BACKEND_RENDER_URL
# VITE_ADMIN_API_KEY=misma-clave-que-ADMIN_API_KEY
# VITE_ENABLE_DEV_FALLBACKS=false
