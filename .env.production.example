# Copy to .env.production on the VPS. Do not commit real secrets.

# Domains and TLS
# Public site and portal domains
APP_PUBLIC_DOMAIN=autogal.es
APP_PUBLIC_WWW_DOMAIN=www.autogal.es
APP_CLIENT_DOMAIN=client.autogal.es
APP_DOMAIN=voice.autogal.es
APP_ADMIN_DOMAIN=admin.autogal.es
CADDY_EMAIL=admin@example.com

# Runtime
APP_ENVIRONMENT=production
LOG_LEVEL=INFO
WEB_CONCURRENCY=1
PORT=10000
# Default for a clean VPS: include local Postgres. For Supabase/external DB,
# set COMPOSE_PROFILES= and DATABASE_URL to your external connection string.
COMPOSE_PROFILES=local-db
INTERNAL_API_KEY=generate-at-least-32-random-characters
ADMIN_API_KEY=generate-a-different-32-character-admin-key
ENABLE_CALL_TRANSCRIPTION=false
PUBLIC_RATE_LIMIT_PER_MINUTE=60
WEBHOOK_RATE_LIMIT_PER_MINUTE=120
MAX_WEBHOOK_BODY_BYTES=1000000
PUBLIC_BASE_URL=https://voice.autogal.es
FRONTEND_BASE_URL=https://admin.autogal.es
CORS_ORIGINS=https://admin.autogal.es,https://client.autogal.es,https://www.autogal.es
AUTH_COOKIE_DOMAIN=.autogal.es
ADMIN_FRONTEND_BASE_URL=https://admin.autogal.es
CLIENT_FRONTEND_BASE_URL=https://client.autogal.es
PUBLIC_SITE_BASE_URL=https://www.autogal.es
ADMIN_PORTAL_HOST=admin.autogal.es
CLIENT_PORTAL_HOST=client.autogal.es

# Database.
# Option A: external Supabase/Postgres, recommended on very small VPS.
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# The backend normalizes postgresql:// to postgresql+psycopg:// and adds
# sslmode=require for Supabase hosts when missing.
#
# Option B: local Postgres profile:
# docker compose -f docker-compose.prod.yml --env-file .env.production --profile local-db up -d --build
DATABASE_URL=postgresql+psycopg://clinic:replace-strong-db-password@postgres:5432/clinic
POSTGRES_DB=clinic
POSTGRES_USER=clinic
POSTGRES_PASSWORD=replace-strong-db-password

# Optional Redis profile. Current MVP does not require Redis, but the service is
# available for future distributed locks/session heartbeat.
REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=128mb

# OpenAI
OPENAI_API_KEY=replace-with-real-openai-api-key
OPENAI_WEBHOOK_SECRET=replace-with-real-openai-webhook-secret
OPENAI_PROJECT_ID=proj_replace_me
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_MODELS=gpt-realtime-2
OPENAI_REALTIME_VOICES=marin,cedar,alloy,ash,ballad,coral,echo,sage,shimmer,verse
TEST_CONSOLE_ENGINE=simulator
TEST_CONSOLE_MODEL=gpt-5.4-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Google Calendar OAuth
GOOGLE_CLIENT_ID=replace-with-real-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-real-google-client-secret
GOOGLE_REDIRECT_URI=https://voice.autogal.es/auth/google/callback
# Google OpenID Connect login for admin/client portals
GOOGLE_LOGIN_ENABLED=true
GOOGLE_LOGIN_ADMIN_REDIRECT_URI=https://admin.autogal.es/auth/login/google/callback
GOOGLE_LOGIN_CLIENT_REDIRECT_URI=https://client.autogal.es/auth/login/google/callback
# Empty means any invited Google account is accepted.
GOOGLE_LOGIN_ALLOWED_DOMAIN=
# Keep false: accounts must first be created and assigned to clinics by a super administrator.
GOOGLE_LOGIN_AUTO_PROVISION=false
# Generate once and keep stable:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Voice providers for VPS Media Bridge / previews.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
GOOGLE_TTS_API_KEY=
ELEVENLABS_API_KEY=
AMAZON_POLLY_REGION=eu-west-1
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
RESEMBLE_API_KEY=
RESEMBLE_TTS_URL=
CUSTOM_HTTP_TTS_URL=
CUSTOM_HTTP_TTS_API_KEY=
LOCAL_TTS_BASE_URL=

# SIP/RTP gateway
SIP_BIND_HOST=0.0.0.0
SIP_PORT=6060
SIP_PUBLIC_DOMAIN=sip.autogal.es
SIP_PUBLIC_IP=51.210.180.115
RTP_PORT_MIN=10000
RTP_PORT_MAX=20000
RTP_ADVERTISE_IP=51.210.180.115
SIP_ALLOWED_IPS=
BACKEND_INTERNAL_URL=http://api:10000
OPENAI_HOSTED_SIP_STRATEGY=blocked
HEALTH_BIND_HOST=0.0.0.0
HEALTH_PORT=8088
MAX_CONCURRENT_CALLS=10
MAX_CALL_SECONDS=1800
INVITE_RATE_LIMIT_PER_MINUTE=60
FALLBACK_CALLED_NUMBER=

# Clinic seed/defaults
CLINIC_TIMEZONE=Europe/Madrid
CLINIC_NAME=Clínica Demo
CLINIC_PHONE_NUMBER=+34910000000

# Container resource limits
API_MEM_LIMIT=768m
FRONTEND_MEM_LIMIT=256m
PUBLIC_FRONTEND_MEM_LIMIT=256m
SIP_GATEWAY_MEM_LIMIT=512m
CADDY_MEM_LIMIT=256m
POSTGRES_MEM_LIMIT=768m
REDIS_MEM_LIMIT=192m

# Frontend build for VPS.
# for /api/admin* so the secret is not embedded into static JS.
VITE_API_BASE_URL=https://admin.autogal.es
VITE_ENABLE_DEV_FALLBACKS=false

# Secure administrator sessions
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=Tatodobajocontrol
ADMIN_BOOTSTRAP_FORCE_PASSWORD_CHANGE=false
ADMIN_SESSION_TTL_HOURS=12
ADMIN_SECURE_COOKIES=true
VITE_API_TIMEOUT_MS=20000

# Retained unchanged for compatibility; the secure session-based frontend does not read this value.
VITE_ADMIN_API_KEY=

# Direct peers whose X-Forwarded-* headers are trusted.
TRUSTED_PROXY_IPS=127.0.0.1,::1
