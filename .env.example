# Copia a .env para levantar API, PostgreSQL y panel desde la raíz.
APP_ENVIRONMENT=development
LOG_LEVEL=INFO
INTERNAL_API_KEY=development-only-internal-key
ADMIN_API_KEY=development-only-admin-api-key
ENABLE_CALL_TRANSCRIPTION=false
PUBLIC_RATE_LIMIT_PER_MINUTE=60
WEBHOOK_RATE_LIMIT_PER_MINUTE=120
MAX_WEBHOOK_BODY_BYTES=1000000
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=https://replace-me.ngrok-free.app
FRONTEND_BASE_URL=http://localhost:5173

OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_WEBHOOK_SECRET=replace-with-openai-webhook-secret
OPENAI_PROJECT_ID=proj_replace_me
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_MODELS=gpt-realtime-2
OPENAI_REALTIME_VOICES=marin,cedar,alloy,ash,ballad,coral,echo,sage,shimmer,verse
TEST_CONSOLE_ENGINE=simulator
TEST_CONSOLE_MODEL=gpt-5.4-mini

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://replace-me.ngrok-free.app/auth/google/callback
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

CLINIC_TIMEZONE=Europe/Madrid
CLINIC_NAME=Clínica Demo
CLINIC_PHONE_NUMBER=+34910000000

POSTGRES_DB=clinic
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic_dev_password
# Producción gratuita:
# - Render Free Web Service usa DATABASE_URL de Supabase Free.
# - Puede venir como postgresql://...; la app lo normaliza a
#   postgresql+psycopg://...
# - Si el host es Supabase y falta sslmode, la app añade sslmode=require.
# Ejemplo:
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# o pooler:
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

VITE_API_BASE_URL=http://localhost:8000
VITE_ADMIN_API_KEY=development-only-admin-api-key
VITE_ENABLE_DEV_FALLBACKS=false

# Cloudflare Pages production:
# VITE_API_BASE_URL=https://BACKEND_RENDER_URL
# VITE_ADMIN_API_KEY=misma-clave-que-ADMIN_API_KEY
# VITE_ENABLE_DEV_FALLBACKS=false
