x-logging: &default-logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "5"

x-hardening: &default-hardening
  security_opt:
    - no-new-privileges:true
  cap_drop:
    - ALL

services:
  migrate:
    build:
      context: ./clinic-voice-agent
      args:
        INSTALL_DEV: "false"
    env_file:
      - ${PRODUCTION_ENV_FILE:-.env.production}
    command: ["alembic", "upgrade", "head"]
    restart: "no"
    networks: [backend, data]
    logging: *default-logging
    <<: *default-hardening

  api:
    build:
      context: ./clinic-voice-agent
      args:
        INSTALL_DEV: "false"
    env_file:
      - ${PRODUCTION_ENV_FILE:-.env.production}
    environment:
      PORT: "10000"
      TRUSTED_PROXY_IPS: ${TRUSTED_PROXY_IPS:-172.30.0.10}
    command:
      - sh
      - -c
      - uvicorn app.main:app --host 0.0.0.0 --port $${PORT:-10000} --workers $${WEB_CONCURRENCY:-1} --proxy-headers --forwarded-allow-ips=$${TRUSTED_PROXY_IPS:-172.30.0.10}
    expose: ["10000"]
    restart: unless-stopped
    depends_on:
      migrate:
        condition: service_completed_successfully
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:10000/health/ready', timeout=3)"]
      interval: 15s
      timeout: 5s
      retries: 8
      start_period: 30s
    logging: *default-logging
    mem_limit: ${API_MEM_LIMIT:-768m}
    read_only: true
    tmpfs: ["/tmp"]
    networks:
      backend:
        ipv4_address: 172.30.0.20
      data: {}
    stop_grace_period: 45s
    <<: *default-hardening

  frontend:
    build:
      context: ./frontend
      target: production
      args:
        VITE_API_BASE_URL: https://${APP_ADMIN_DOMAIN}
        VITE_API_TIMEOUT_MS: ${VITE_API_TIMEOUT_MS:-20000}
        VITE_ENABLE_DEV_FALLBACKS: "false"
    expose: ["8080"]
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:8080/"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    logging: *default-logging
    mem_limit: ${FRONTEND_MEM_LIMIT:-256m}
    read_only: true
    tmpfs:
      - /var/cache/nginx:rw,nosuid,nodev,noexec,mode=1777
      - /var/run:rw,nosuid,nodev,noexec,mode=1777
      - /tmp:rw,nosuid,nodev,noexec,mode=1777
    networks: [edge]
    <<: *default-hardening

  sip-gateway:
    build:
      context: ./sip-gateway
    env_file:
      - ${PRODUCTION_ENV_FILE:-.env.production}
    environment:
      BACKEND_INTERNAL_URL: http://api:10000
      HEALTH_BIND_HOST: 0.0.0.0
      HEALTH_PORT: 8088
    ports:
      - "${SIP_PORT:-6060}:${SIP_PORT:-6060}/udp"
      - "${RTP_PORT_MIN:-10000}-${RTP_PORT_MAX:-10100}:${RTP_PORT_MIN:-10000}-${RTP_PORT_MAX:-10100}/udp"
    expose: ["8088"]
    restart: unless-stopped
    depends_on:
      api:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8088/health/ready', timeout=3)"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 15s
    logging: *default-logging
    mem_limit: ${SIP_GATEWAY_MEM_LIMIT:-512m}
    read_only: true
    tmpfs: ["/tmp"]
    networks:
      edge: {}
      backend:
        ipv4_address: 172.30.0.30
    stop_grace_period: 45s
    <<: *default-hardening

  caddy:
    image: caddy:2-alpine
    env_file:
      - ${PRODUCTION_ENV_FILE:-.env.production}
    environment:
      APP_DOMAIN: ${APP_DOMAIN}
      APP_ADMIN_DOMAIN: ${APP_ADMIN_DOMAIN}
      CADDY_EMAIL: ${CADDY_EMAIL}
    ports:
      - "80:80/tcp"
      - "443:443/tcp"
      - "443:443/udp"
    volumes:
      - ./deploy/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    restart: unless-stopped
    depends_on:
      api:
        condition: service_healthy
      frontend:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "caddy", "validate", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
      interval: 30s
      timeout: 5s
      retries: 3
    logging: *default-logging
    mem_limit: ${CADDY_MEM_LIMIT:-256m}
    networks:
      edge: {}
      backend:
        ipv4_address: 172.30.0.10
    <<: *default-hardening

  postgres:
    image: postgres:16-alpine
    profiles: ["local-db"]
    env_file:
      - ${PRODUCTION_ENV_FILE:-.env.production}
    environment:
      POSTGRES_DB: ${POSTGRES_DB:-clinic}
      POSTGRES_USER: ${POSTGRES_USER:-clinic}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - postgres_backups:/backups
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U \"$${POSTGRES_USER}\" -d \"$${POSTGRES_DB}\""]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 10s
    logging: *default-logging
    mem_limit: ${POSTGRES_MEM_LIMIT:-768m}
    networks: [data]
    security_opt: ["no-new-privileges:true"]

  redis:
    image: redis:7-alpine
    profiles: ["redis"]
    command: ["redis-server", "--appendonly", "yes", "--maxmemory", "${REDIS_MAXMEMORY:-128mb}", "--maxmemory-policy", "allkeys-lru"]
    volumes: ["redis_data:/data"]
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    logging: *default-logging
    mem_limit: ${REDIS_MEM_LIMIT:-192m}
    networks: [backend, data]
    security_opt: ["no-new-privileges:true"]

networks:
  edge:
  backend:
    ipam:
      config:
        - subnet: 172.30.0.0/24
  data:
    internal: true

volumes:
  caddy_data:
  caddy_config:
  postgres_data:
  postgres_backups:
  redis_data:
