# Runtime
APP_ENVIRONMENT=development
LOG_LEVEL=INFO
INTERNAL_API_KEY=development-only-internal-key
ADMIN_API_KEY=development-only-admin-api-key
ENABLE_CALL_TRANSCRIPTION=false
PUBLIC_RATE_LIMIT_PER_MINUTE=60
WEBHOOK_RATE_LIMIT_PER_MINUTE=120
MAX_WEBHOOK_BODY_BYTES=1000000
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=https://replace-me.ngrok-free.app
FRONTEND_BASE_URL=http://localhost:5173
DATABASE_URL=postgresql+psycopg://clinic:clinic_dev_password@postgres:5432/clinic

# OpenAI
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_WEBHOOK_SECRET=replace-with-openai-webhook-secret
OPENAI_PROJECT_ID=proj_replace_me
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Optional voice providers for preview/VPS Media Bridge.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GOOGLE_TTS_API_KEY=
ELEVENLABS_API_KEY=
AMAZON_POLLY_REGION=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
RESEMBLE_API_KEY=
RESEMBLE_TTS_URL=
CUSTOM_HTTP_TTS_URL=
CUSTOM_HTTP_TTS_API_KEY=
LOCAL_TTS_BASE_URL=

# SIP gateway for VPS Media Bridge.
SIP_BIND_HOST=0.0.0.0
SIP_PORT=6060
SIP_PUBLIC_DOMAIN=
SIP_PUBLIC_IP=127.0.0.1
RTP_PORT_MIN=10000
RTP_PORT_MAX=20000
RTP_ADVERTISE_IP=127.0.0.1
SIP_ALLOWED_IPS=
BACKEND_INTERNAL_URL=http://app:8000
HEALTH_BIND_HOST=0.0.0.0
HEALTH_PORT=8088
MAX_CONCURRENT_CALLS=10
MAX_CALL_SECONDS=1800
INVITE_RATE_LIMIT_PER_MINUTE=60
FALLBACK_CALLED_NUMBER=

# Google
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://replace-me.ngrok-free.app/auth/google/callback
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Clinic
CLINIC_TIMEZONE=Europe/Madrid
CLINIC_NAME=Clínica Demo
CLINIC_PHONE_NUMBER=+34910000000

# PostgreSQL
POSTGRES_DB=clinic
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic_dev_password
# Render inyecta DATABASE_URL desde Postgres gestionado; puede venir como
# postgresql://... y la app lo normaliza a postgresql+psycopg://...
